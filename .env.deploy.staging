MINIO_ENDPOINT=s3.bratislava.sk
MINIO_BUCKET=kupaliska-staging

COMMISSION_COEFFICIENT=0.015
MAX_TICKET_PURCHASE_LIMIT=50
MIN_ZIP_CODE_FREQUENCY=10

SCHEDULE_CHECK_CREATED_UNPAID_ORDERS=0 */1 * * * *
