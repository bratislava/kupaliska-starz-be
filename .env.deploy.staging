# Non-secret env for the staging cluster, read at deploy time by
# infrastructure-deployment-configuration and turned into the app ConfigMap.
# Every value must fit on a single line: no line continuation, no escapes.
# Secrets live in Passbolt, never here - as does anything multiline.

NODE_ENV=production
PORT=3000
HOST=https://api-kupaliska.staging.bratislava.sk

CORS_ORIGINS=["https://www.kupaliska.staging.bratislava.sk", "https://kupaliska.staging.bratislava.sk", "https://login-kupaliska.staging.bratislava.sk", "http://localhost:3000"]
FE_RESET_PASSWORD_URL=https://login-kupaliska.staging.bratislava.sk/reset-password
CITY_ACCOUNT_BE_URL=https://nest-city-account.staging.bratislava.sk

AWS_COGNITO_COGNITO_CLIENT_ID=1pdeai19927kshpgikd6l1ptc6
AWS_COGNITO_REGION=eu-central-1
AWS_COGNITO_USERPOOL_ID=eu-central-1_FZDV0j2ZK

CONTACT_EMAIL=kupaliska@bratislava.sk
MAILGUN_DOMAIN=digital.bratislava.sk
MAILGUN_EMAIL_FROM=Kúpaliská STaRZ<kupaliska@bratislava.sk>
MAILGUN_HOST=https://api.eu.mailgun.net
MAILGUN_TEMPLATE_ORDER=kupaliska-purchased-tickets
MAILGUN_TEMPLATE_RESET_PASSWORD=kupaliska-reset-password
MAILGUN_TEMPLATE_SET_PASSWORD=kupaliska-set-password

GP_WEBPAY_CLIENT_APP_URL=https://kupaliska.staging.bratislava.sk
GP_WEBPAY_CURRENCY=978
GP_WEBPAY_HTTP_API_URL=https://test.3dsecure.gpwebpay.com
GP_WEBPAY_KEYS_PATH=resources/keys
GP_WEBPAY_MERCHANT_NUMBER=8888890140
